# the conditioned UNet: shapes, a fresh model predicting 0, and both the context
# frames and the action reaching the output
import pytest
import torch
from torch import Tensor, nn

from model import UNet, UNetConfig

B, K, C, H, W = 2, 2, 3, 16, 16
N_ACTIONS = 5


@pytest.fixture
def cfg() -> UNetConfig:
    return (
        frame_channels=C, n_context=K, n_actions=N_ACTIONS,
        channels=(16, 32), time_dim=32, groups=4,
    )


# UNet.forward's arguments, by name, so model(**inputs()) passes each to its
# parameter and a variant is inputs()._replace(action=...)
type Inputs = (x_t: Tensor, t: Tensor, context: Tensor, action: Tensor)


def inputs() -> Inputs:
    # one random batch
    return (
        x_t=torch.randn(B, C, H, W),
        t=torch.rand(B),
        context=torch.randn(B, K, C, H, W),
        action=torch.tensor([1, 3]),
    )


def test_output_is_one_frame(cfg: UNetConfig):
    assert UNet(cfg)(**inputs()).shape == (B, C, H, W)


def test_a_fresh_model_predicts_zero(cfg: UNetConfig):
    # the output conv starts at 0, so the first loss is that of predicting 0
    assert (UNet(cfg)(**inputs()) == 0).all()


def trained_looking(cfg: UNetConfig) -> UNet:
    # a fresh model's zero-init convs (each ResBlock's conv2 and conv_out) are
    # given random weights, as training would. Until then the action has no
    # path to the output: it enters each ResBlock before that block's conv2
    model = UNet(cfg)
    for module in model.modules():
        if isinstance(module, nn.Conv2d) and (module.weight == 0).all():
            nn.init.normal_(module.weight, std=0.1)
    return model


def test_the_action_changes_the_output(cfg: UNetConfig):
    model = trained_looking(cfg)
    batch = inputs()
    other = batch._replace(action=(batch.action + 1) % N_ACTIONS)
    assert not torch.allclose(model(**batch), model(**other))


def test_the_context_changes_the_output(cfg: UNetConfig):
    model = trained_looking(cfg)
    batch = inputs()
    other = batch._replace(context=torch.randn(B, K, C, H, W))
    assert not torch.allclose(model(**batch), model(**other))


def test_the_wrong_number_of_context_frames_is_refused(cfg: UNetConfig):
    batch = inputs()
    one_frame = batch._replace(context=batch.context[:, :1])
    with pytest.raises(AssertionError, match="expected 2 context frames, got 1"):
        UNet(cfg)(**one_frame)
